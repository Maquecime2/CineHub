{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* La migration se fait fichier par fichier : le JS existant doit continuer
       de compiler à côté du TS, sans être vérifié tant qu'il n'est pas porté. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Vite transpile fichier par fichier : il ne voit jamais le programme
       entier, d'où ces contraintes. Le typage réel passe par `npm run typecheck`. */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* `vite/client` donne `import.meta.env` : sans lui, le seul endroit qui
       demande « suis-je en développement ? » (le relais du flux Letterboxd)
       ne compile pas. */
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "vite.config.ts"]
}
