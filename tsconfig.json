{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* The migration happens file by file: the existing JS must go on
       compiling beside the TS, unchecked until it has been ported. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Vite transpiles file by file: it never sees the whole program,
       hence these constraints. The real typing goes through
       `npm run typecheck`. */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* `vite/client` gives `import.meta.env`: without it, the one place
       that asks "am I in development?" (the Letterboxd feed's relay) does
       not compile. */
    /* `vite-plugin-pwa/react` declares the virtual module
       `virtual:pwa-register/react`, which only exists at build time:
       without it, the update banner does not compile. */
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom",
      "vite-plugin-pwa/react"
    ]
  },
  "include": ["src", "vite.config.ts"]
}
