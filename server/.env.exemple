# À recopier en `.env` — qui n'est pas versionné, et ne doit jamais l'être.

# La base. Celle du docker-compose voisin, en développement.
DATABASE_URL=postgres://cinehub:cinehub@localhost:5432/cinehub

# LE DOMAINE QUE LES CLÉS D'ACCÈS SIGNENT.
# Une clé enregistrée pour un domaine ne vaut RIEN sur un autre : c'est
# ce qui rend le hameçonnage impossible, et c'est aussi ce qui fait que
# se tromper ici rend toutes les clés inutilisables du jour au lendemain.
# Le domaine, sans protocole ni port.
RP_ID=localhost

# L'origine exacte du client, protocole et port compris.
ORIGINE=http://localhost:5173

PORT=8787

# En production : NODE_ENV=production, ce qui pose `Secure` sur le cookie
# de session. Sans HTTPS derrière, la session ne s'installera pas — c'est
# voulu.
NODE_ENV=development
