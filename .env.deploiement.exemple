# ============================================================
#  CE QU'IL FAUT POUR DÉPLOYER — à recopier en `.env`
# ============================================================
#
#      cp .env.deploiement.exemple .env
#      # on remplit
#      docker compose --env-file .env up -d --build
#
#  `.env` n'est pas versionné. Celui-ci l'est, et ne contient donc
#  AUCUN secret — que des exemples.
# ============================================================

# ------------------------------------------------------------
#  LES TROIS NOMS DE DOMAINE
# ------------------------------------------------------------
#  Ils doivent pointer sur l'adresse du VPS avant le premier démarrage :
#  Caddy demande ses certificats tout seul, et il ne peut le faire que
#  si le nom résout déjà.
#
#  LA MESURE EST SUR UN SOUS-DOMAINE À VOUS, et c'est la moitié de
#  l'intérêt de l'héberger soi-même : un script servi depuis un domaine
#  tiers est ce que les bloqueurs découpent en premier.
#  `DOMAINE` sert aussi de domaine aux PASSKEYS (`RP_ID`) : une clé y est
#  signée, et elle n'ouvre rien ailleurs. Le changer plus tard
#  invaliderait les clés déjà posées — c'est le seul de ces trois noms
#  qu'on ne peut pas renommer à la légère.
DOMAINE=cinehub.exemple.fr
DOMAINE_API=api.cinehub.exemple.fr
DOMAINE_MESURE=mesure.cinehub.exemple.fr

# ------------------------------------------------------------
#  LA BASE
# ------------------------------------------------------------
#  Elle n'est publiée sur aucun port : ces identifiants ne servent qu'aux
#  conteneurs entre eux. Un mot de passe long quand même — un conteneur mal
#  configuré un jour ne doit pas ouvrir la porte.
PG_USER=cinehub
PG_PASSWORD=
PG_DB=cinehub

# ------------------------------------------------------------
#  L'ADMINISTRATION
# ------------------------------------------------------------
#  Le rôle est posé à CHAQUE démarrage, et aucune requête ne peut
#  l'accorder : un rôle dans lequel personne ne peut monter. Le retirer
#  se fait à la main en base — enlever un pseudonyme d'ici ne le reprend
#  pas, et c'est le comportement honnête d'une ligne qui ne fait
#  qu'accorder.
#
#  L'admin passe au-dessus de tous les plafonds.
ADMINS=maquecime

# ------------------------------------------------------------
#  TMDB
# ------------------------------------------------------------
#  Le serveur relaie TMDB pour les comptes ouverts, et s'en sert aussi
#  au premier démarrage pour résoudre les affiches des douze fiches de
#  la vitrine. Sans clé, la vitrine dessine des initiales et le relais
#  répond « pas de service » — rien ne casse.
TMDB_KEY=

# ------------------------------------------------------------
#  LE MIROIR DES MÉDIAS
# ------------------------------------------------------------
#  Facultatif de bout en bout. Sans lui, les affiches et les captures
#  restent sur la machine de chacun et ne suivent pas d'un appareil à
#  l'autre — le reste fonctionne.
#
#  `CSP_MEDIAS` doit nommer la MÊME origine, sans quoi le navigateur
#  refusera d'afficher les images qu'il vient de recevoir. Laisser vide
#  si le miroir n'est pas branché.
AZURE_BLOBS=
AZURE_CONTAINER=medias
CSP_MEDIAS=

# ------------------------------------------------------------
#  LES NOTIFICATIONS
# ------------------------------------------------------------
#  Facultatives. Sans elles, le classeur n'en propose pas.
#      npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=

# ------------------------------------------------------------
#  LES PLAFONDS DU PALIER ABONNÉ
# ------------------------------------------------------------
#  Le gratuit en prend la moitié, plus un import par mois. L'admin n'en
#  a aucun. Voir `server/src/limits.ts`, qui les tient tous.
#
#  Ces chiffres viennent d'un usage — une collection de six cents films
#  porte six cents affiches — et non d'une facture. À revoir quand vous
#  saurez ce que coûte votre container.
PLAFOND_MEDIAS=2000
PLAFOND_DECORS=200
PLAFOND_DECORS_OCTETS=41943040

# ------------------------------------------------------------
#  LA MESURE
# ------------------------------------------------------------
#  `UMAMI_SECRET` signe les sessions d'Umami : n'importe quelle chaîne
#  longue et tirée au hasard, gardée stable.
#      openssl rand -hex 32
#
#  `UMAMI_SITE_ID` n'existe qu'APRÈS le premier démarrage : on ouvre
#  https://mesure.… , on crée le site, on recopie son identifiant ici,
#  puis on reconstruit le classeur — la variable est cuite dans le
#  paquet, elle ne se lit pas au démarrage.
#
#      docker compose up -d --build classeur
#
#  Tant qu'il est vide, aucun script n'est chargé et aucune requête ne
#  part : la mesure est absente, pas cassée.
UMAMI_SECRET=
UMAMI_SITE_ID=
